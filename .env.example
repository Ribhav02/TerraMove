# TerraMove Environment Configuration
# Copy this file to .env and insert your private Supabase keys

# --- Supabase Project Configuration ---
# Your Project URL (already configured for project: czjijgsntgsvbbpvkfbz)
SUPABASE_URL=https://czjijgsntgsvbbpvkfbz.supabase.co

# Publishable / Anon API Key (from: Project Settings -> API -> anon public)
SUPABASE_KEY=your-anon-publishable-key-here

# Service Role Secret Key (Optional / Backend only: Project Settings -> API -> service_role secret)
# Required for running administrative database import scripts with full permissions
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# Direct PostgreSQL Connection URI (Optional: Project Settings -> Database -> Connection string)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.czjijgsntgsvbbpvkfbz.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.czjijgsntgsvbbpvkfbz.supabase.co:5432/postgres

# --- External APIs & Server ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
PORT=8000
HOST=0.0.0.0

# --- Smart Parking Security (Backend only) ---
# Secret token required for ground staff / field operators to update physical parking occupancy
OPERATOR_SECRET_KEY=your-secure-operator-secret-token-here

# Secret token required for IoT ultrasonic sensor telemetry ingestion
IOT_SECRET_KEY=your-secure-iot-device-key-here
